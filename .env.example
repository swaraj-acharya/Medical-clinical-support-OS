# ---------------------------------------------------------------
# Clinical Decision Support Platform — environment configuration
# Copy to .env.local and adjust. Never commit real secrets.
# ---------------------------------------------------------------

# Access control. When set, every page and API route requires sign-in with this token.
# Leave empty ONLY for local development with synthetic data.
CDS_ACCESS_TOKEN=

# Secret used to sign the session cookie (min 32 chars). Required when CDS_ACCESS_TOKEN is set.
CDS_SESSION_SECRET=

# Where cases, analyses and the audit log are stored (JSON files). Default: ./data/runtime
CDS_DATA_DIR_RUNTIME=

# AI assistance. "off" = Deterministic Mode (default). The candidate pipeline never depends on AI.
# "extract" = LLM may be used ONLY to map free-text complaints to knowledge-base concept IDs.
CDS_AI_MODE=off
ANTHROPIC_API_KEY=
CDS_AI_MODEL=claude-sonnet-5
# Patient identifiers are always stripped before any external call. Set to "true" only if your
# data-processing agreement explicitly permits sending clinical free text to the AI provider.
CDS_AI_ALLOW_CLINICAL_TEXT=false

# Optional network importers (run on a machine with internet access)
OPENFDA_API_KEY=

# Production safety: without CDS_ACCESS_TOKEN the app refuses all requests in production (fail closed).
# Set to "true" ONLY for a local demo with synthetic data (e.g. `npm run build && npm start` on your laptop).
CDS_ALLOW_UNAUTHENTICATED=false

# Disable the "Load demo cases" action (recommended in any real deployment).
CDS_DISABLE_DEMO=false
