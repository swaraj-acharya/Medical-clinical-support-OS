   "category": "Obstetric",
   "severity": "urgent",
   "population": "pregnancy",
   "when": {
    "all": [
     {
      "pregnant": true
     },
     {
      "symptom": "sym_headache"
     }
    ]
   },
   "guidance": "Headache in pregnancy: check blood pressure and urine protein; consider pre-eclampsia before symptomatic treatment.",
   "sources": [
    {
     "sourceId": "nice",
     "reference": "NICE NG133: Hypertension in pregnancy",
     "lastVerified": "2026-09-25",
     "url": "https://www.nice.org.uk/guidance/ng133"
    }
   ],
   "verification": "curated-pending-verification"
  },
  {
   "id": "rf_early_pregnancy_bleeding",
   "title": "Pregnancy with vaginal bleeding or severe abdominal pain",
   "category": "Obstetric",
   "severity": "emergency",
   "population": "pregnancy",
   "when": {
    "all": [
     {
      "pregnant": true
     },
     {
      "any": [
       {
        "symptom": "sym_vaginal_bleeding"
       },
       {
        "detail": {
         "symptomId": "sym_abdominal_pain",
         "field": "severity",
         "anyOf": [
          "severe"
         ]
        }
       }
      ]
     }
    ]
   },
