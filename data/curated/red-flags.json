  {
   "id": "rf_pregnancy_hypertension_symptoms",
   "title": "Pregnancy with raised BP and headache/visual symptoms",
   "category": "Obstetric",
   "severity": "emergency",
   "population": "pregnancy",
   "when": {
    "all": [
     {
      "pregnant": true
     },
     {
      "any": [
       {
        "symptom": "sym_headache"
       },
       {
        "symptom": "sym_visual_disturbance"
       }
      ]
     },
     {
      "any": [
       {
        "vital": {
         "name": "systolicBP",
         "op": ">=",
         "value": 140
        }
       },
       {
        "vital": {
         "name": "diastolicBP",
         "op": ">=",
         "value": 90
        }
       }
      ]
     }
    ]
   },
   "guidance": "Possible pre-eclampsia. Arrange same-day obstetric assessment.",
   "sources": [
    {
     "sourceId": "nice",
     "reference": "NICE NG133: Hypertension in pregnancy",
     "lastVerified": "2026-09-25",
     "url": "https://www.nice.org.uk/guidance/ng133"
    }
   ],
   "verification": "curated-pending-verification"
  },
  {
   "id": "rf_pregnancy_headache",
