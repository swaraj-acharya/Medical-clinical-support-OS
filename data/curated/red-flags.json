  {
   "id": "rf_qsofa_sepsis",
   "title": "Possible sepsis (qSOFA ≥ 2)",
   "category": "Infection",
   "severity": "emergency",
   "population": "adult",
   "when": {
    "countAtLeast": {
     "n": 2,
     "of": [
      {
       "vital": {
        "name": "respiratoryRate",
        "op": ">=",
        "value": 22
       }
      },
      {
       "any": [
        {
         "symptom": "sym_confusion"
        },
        {
         "vital": {
          "name": "gcs",
          "op": "<",
          "value": 15
         }
        }
       ]
      },
      {
       "vital": {
        "name": "systolicBP",
        "op": "<=",
        "value": 100
       }
      }
     ]
    }
   },
   "guidance": "qSOFA ≥ 2 identifies patients with suspected infection at higher risk of poor outcome. Assess for sepsis urgently.",
   "sources": [
    {
     "sourceId": "sepsis-3",
     "reference": "Singer M, et al. The Third International Consensus Definitions for Sepsis and Septic Shock (Sepsis-3). JAMA 2016 — qSOFA",
     "lastVerified": "2026-09-25",
     "url": "https://doi.org/10.1001/jama.2016.0287"
    }
   ],
   "verification": "curated-pending-verification"
  },
  {
   "id": "rf_news2_red_parameter",
   "title": "Single vital sign in NEWS2 red range",
   "category": "Physiology",
   "severity": "urgent",
   "population": "adult",
   "when": {
    "any": [
     {
      "vital": {
       "name": "respiratoryRate",
       "op": "<=",
       "value": 8
      }
     },
     {
      "vital": {
       "name": "respiratoryRate",
       "op": ">=",
       "value": 25
      }
     },
     {
      "vital": {
       "name": "spo2",
       "op": "<=",
       "value": 91
      }
     },
     {
      "vital": {
       "name": "systolicBP",
       "op": "<=",
       "value": 90
      }
     },
     {
      "vital": {
       "name": "systolicBP",
       "op": ">=",
       "value": 220
      }
     },
     {
      "vital": {
       "name": "heartRate",
       "op": "<=",
       "value": 40
