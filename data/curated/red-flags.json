{
 "rules": [
  {
   "id": "rf_thunderclap_headache",
   "title": "Thunderclap / sudden severe headache",
   "category": "Neurological",
   "severity": "emergency",
   "population": "all",
   "when": {
    "any": [
     {
      "flag": "flag_thunderclap"
     },
     {
      "all": [
       {
        "symptom": "sym_headache"
       },
       {
        "detail": {
         "symptomId": "sym_headache",
         "field": "onset",
         "anyOf": [
          "sudden"
         ]
        }
       },
       {
        "detail": {
         "symptomId": "sym_headache",
         "field": "severity",
         "anyOf": [
          "severe"
         ]
        }
       }
      ]
     }
    ]
   },
   "guidance": "Sudden-onset severe headache requires same-day emergency assessment to exclude subarachnoid haemorrhage and other secondary causes.",
   "sources": [
    {
     "sourceId": "nhs-scotland-headache",
     "reference": "NHS Scotland National Headache Pathway — red flags",
     "lastVerified": "2026-09-25",
     "url": "https://www.rightdecisions.scot.nhs.uk/borders-ref-help-toolkit/headache/1-national-headache-pathway/"
    },
    {
     "sourceId": "rcem-learning",
     "reference": "RCEM Learning — headache red flag symptoms",
     "lastVerified": "2026-09-25",
     "url": "https://www.rcemlearning.co.uk/?p=12491"
    },
    {
     "sourceId": "nice",
     "reference": "NICE CG150: Headaches in over 12s",
     "lastVerified": "2026-09-25",
     "url": "https://www.nice.org.uk/guidance/cg150"
    }
   ],
   "verification": "curated-pending-verification"
  },
  {
   "id": "rf_meningism",
   "title": "Headache or fever with neck stiffness",
   "category": "Infection / neurological",
   "severity": "emergency",
   "population": "all",
   "when": {
    "all": [
     {
      "symptom": "sym_neck_stiffness"
     },
     {
      "any": [
       {
        "symptom": "sym_headache"
       },
       {
        "any": [
         {
          "symptom": "sym_fever"
         },
         {
          "vital": {
           "name": "temperatureC",
           "op": ">=",
           "value": 38
          }
         }
        ]
       }
      ]
     }
    ]
   },
   "guidance": "Fever/headache with neck stiffness may indicate meningitis or subarachnoid haemorrhage. Arrange emergency assessment.",
   "sources": [
    {
     "sourceId": "nhs-scotland-headache",
     "reference": "NHS Scotland National Headache Pathway — red flags",
     "lastVerified": "2026-09-25",
